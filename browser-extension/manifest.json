{
  "manifest_version": 3,
  "name": "LightLock Receiver",
  "description": "Secure credential transfer via optical communication — QR code challenge, OOK light signal response",
  "version": "2.0",
  "action": {
    "default_popup": "popup.html",
    "default_title": "LightLock"
  },
  "permissions": [
    "activeTab",
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}